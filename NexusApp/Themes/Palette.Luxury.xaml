<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- MOBIGLAS palette: diegetic holographic HUD.
         Void-black base with a cyan holographic bias. Ice-cyan is the product
         accent. Amber stays on WarnColor and GoldColor for caution only. -->

    <!-- structural surfaces -->
    <Color x:Key="BgColor">#FF05090C</Color>          <!-- void with cyan bias -->
    <Color x:Key="Bg2Color">#FF071016</Color>         <!-- void-2 -->
    <Color x:Key="Bg3Color">#FF0C1820</Color>         <!-- raised panel -->
    <Color x:Key="BorderColor">#337FE9E0</Color>      <!-- cyan hairline (line-strong) -->
    <Color x:Key="NavBorderColor">#1A7FE9E0</Color>   <!-- cyan hairline (line) -->
    <Color x:Key="FgColor">#FFEAF1F6</Color>          <!-- text -->
    <Color x:Key="FgDimColor">#FF8693A0</Color>       <!-- dim -->
    <Color x:Key="AccentColor">#FF7FE9E0</Color>      <!-- ice-cyan primary -->
    <Color x:Key="AccentDimColor">#297FE9E0</Color>   <!-- cyan-dim .16 -->
    <Color x:Key="GoldColor">#FFFFD089</Color>        <!-- amber-bright (warn highlight) -->
    <Color x:Key="NavBgColor">#FF061016</Color>       <!-- rail -->
    <Color x:Key="PageBgColor">#FF071218</Color>      <!-- content area -->
    <Color x:Key="Bg2NavColor">#FF0C1820</Color>      <!-- card surface -->
    <Color x:Key="HighlightColor">#1F7FE9E0</Color>   <!-- hover tint (faint cyan) -->

    <!-- accent-derived (alpha variants of cyan #7FE9E0) -->
    <Color x:Key="AccentClearColor">#007FE9E0</Color>
    <Color x:Key="AccentFaintColor">#1F7FE9E0</Color>
    <Color x:Key="AccentTintColor">#297FE9E0</Color>
    <Color x:Key="AccentSoftColor">#557FE9E0</Color>
    <Color x:Key="AccentGlowColor">#667FE9E0</Color>
    <Color x:Key="AccentStrongColor">#6B7FE9E0</Color>
    <Color x:Key="AccentHoverColor">#FFB8FFF6</Color>
    <Color x:Key="AccentPressColor">#FF4ECFC4</Color>
    <Color x:Key="OnAccentColor">#FF05090C</Color>     <!-- void text on cyan -->
    <Color x:Key="AccentActiveFillColor">#247FE9E0</Color>
    <Color x:Key="AccentHairlineColor">#2E7FE9E0</Color>

    <!-- ice-cyan secondary (live readouts, lock-on, data ticks) -->
    <Color x:Key="CyanColor">#FF7FE9E0</Color>
    <Color x:Key="CyanDimColor">#247FE9E0</Color>
    <Color x:Key="CyanLineColor">#1A7FE9E0</Color>
    <Color x:Key="CyanGlowColor">#447FE9E0</Color>
    <Color x:Key="CyanStrongColor">#667FE9E0</Color>
    <Color x:Key="OnCyanColor">#FF062422</Color>       <!-- text on filled cyan -->

    <!-- semantic (status, used by pages) -->
    <Color x:Key="DangerColor">#FFFF6B6B</Color>
    <Color x:Key="OkColor">#FF66E6A6</Color>
    <Color x:Key="WarnColor">#FFFFB23E</Color>

    <!-- overlay panel gradient -->
    <Color x:Key="OverlayBgTopColor">#F20C1820</Color>
    <Color x:Key="OverlayBgBotColor">#F205090C</Color>
</ResourceDictionary>
